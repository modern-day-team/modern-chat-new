# ModernChat 一键部署环境变量示例
#
# 复制为 .env 后按需填写，或直接导出环境变量：
#   cp .env.example .env
#
# docker compose 会自动读取 .env；未设置必填项时 compose 报错并提示。

# ── 必填：安全凭据 ──────────────────────────────────────────────

# JWT 签名密钥（≥32 字节）。生成方式：
#   openssl rand -hex 32
# 同时作为 system_settings 敏感项的加密密钥，切勿使用弱值或公开串。
JWT_SECRET=

# MySQL root 密码。生成方式：
#   openssl rand -base64 24
# 同时用于 docker-compose 的 MYSQL_ROOT_PASSWORD 与 DB_DSN。
MYSQL_ROOT_PASSWORD=

# ── 可选：构建版本注入 ──────────────────────────────────────────

# 版本号 / 提交 / 构建时间，用于 server/Dockerfile 的版本注入
# VERSION=
# COMMIT=
# BUILD_TIME=

# ── 可选：镜像源（国内网络）─────────────────────────────────────

# GO_IMAGE=
# RUNTIME_IMAGE=
# GOPROXY=
# APK_MIRROR=

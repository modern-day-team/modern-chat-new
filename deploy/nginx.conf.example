# ModernChat Nginx 配置示例（官网 + 聊天室同域部署）
# 前端构建产物：
#   website/dist → /var/www/modernchat/            （官网，站点根）
#   web/dist     → /var/www/modernchat/app/        （聊天前端，web 的 vite base 固定为 /app/）
# 后端：Go 服务监听 127.0.0.1:8080
#
# ⚠️ web/dist 必须放在站点根的 app/ 子目录：web 构建时 base='/app/'，
#    index.html 里的 /app/assets/*、/app/sw.js 都是绝对路径，放错位置会全部 404。
#    若只部署聊天室、不要官网：把 website 的 location / 段删掉，root 仍指向包含 app/ 的目录。
#
# TLS 证书：将证书文件放到指定路径（或改 ssl_certificate / ssl_certificate_key 的路径），
# 生成自签名证书（仅本地测试）：
#   openssl req -x509 -newkey rsa:2048 -nodes \
#     -keyout /etc/nginx/ssl/modernchat.key \
#     -out /etc/nginx/ssl/modernchat.crt -days 365

# HTTP → HTTPS 重定向
server {
    listen 80;
    server_name your-domain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name your-domain.com;

    # ===== TLS 配置 =====
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_certificate /etc/nginx/ssl/modernchat.crt;
    ssl_certificate_key /etc/nginx/ssl/modernchat.key;

    root /var/www/modernchat;
    index index.html;

    # ===== 压缩 =====
    # 优先发送预压缩文件（npm run build 会同时产出 .gz / .br），**零运行时 CPU**；
    # 找不到同名预压缩文件时，回落到底下的 gzip 实时压缩。
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/javascript application/javascript
        application/json application/xml image/svg+xml;
    gzip_static on;

    # brotli 比 gzip 再省约 13%，但官方 nginx 未内置该模块。
    # 启用前先确认：nginx -V 2>&1 | grep -i brotli
    # 确认有模块后再取消注释：
    # brotli on;
    # brotli_static on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css application/javascript application/json image/svg+xml;

    # ===== 安全响应头（nginx 侧必须配，API 响应头由后端中间件负责）=====
    # X-Frame-Options：禁止本站被 iframe 嵌套，防点击劫持（诱导站长点「封禁/删除」）
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # CSP 模板：**默认注释掉**。插件沙箱用 iframe srcdoc + 内联脚本运行插件代码，
    # srcdoc 会继承父页面 CSP，若 script-src 不含 'unsafe-inline' 插件系统会整体失效。
    # 修改插件运行机制（如改为外链沙箱页）之后再启用下面这行：
    # add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # ===== 官网（history 路由回退）=====
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ===== 聊天前端（web/dist 部署在站点根的 app/ 子目录）=====
    # /app/ 用普通前缀（非 ^~），让下面的 /app/assets/ 正则缓存规则优先生效。
    location /app/ {
        try_files $uri $uri/ /app/index.html;
        # index.html / sw.js 不缓存：升级后必须立即加载新版本并清理旧 SW
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    }

    # 带指纹的静态资源长缓存（正则同时命中官网 /assets/ 和聊天 /app/assets/）
    location ~* ^/(app/)?assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        # nginx add_header 不跨层级继承：此 location 定义了 add_header 后，
        # server 级安全头不再自动继承，必须在此重复声明
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    }

    # Service Worker 必须禁用缓存，否则升级后旧 SW 继续生效（web/public/sw.js）
    location = /app/sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ===== 对象存储私有空间反代（可选，如启用七牛私有空间）=====
    # location /qiniu/ {
    #     resolver 8.8.8.8 valid=30s;   # 不要写死 proxy_pass 域名，见运维手册 §1.1
    #     proxy_pass https://your-bucket.qiniudn.com/;
    # }

    # REST API
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 2m;   # 插件上传 1MB + 余量
    }

    # 媒体上传（multipart）：应用侧 200 MB 天花板 + 余量，nginx 不放宽会先回 413
    location /api/upload {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 210m;
        proxy_request_buffering off;
    }

    # WebSocket（/ws 握手 + 升级）
    location /ws {
        # 浏览器无法为 WebSocket 自定义请求头，token 只能走 query（?token=...）。
        # 若按默认 access_log 记录完整 URI，日志里会留下**可用令牌**（CWE-598）：
        # 任何能读日志的人都能拿它劫持会话。因此关闭该路径的访问日志。
        access_log off;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;   # 心跳 25s，留足余量
        proxy_send_timeout 300s;
    }
}
